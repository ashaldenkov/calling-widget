{
  "name": "call-widget-demo",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "widget",
    "demo"
  ],
  "scripts": {
    "build:widget": "npm -w widget run build",
    "copy:widget": "node scripts/copy-widget-dist.mjs",
    "build:demo": "npm run build:widget && npm run copy:widget && npm -w demo run build",
    "dev:demo": "npm run build:widget && npm run copy:widget && npm -w demo run dev",
    "lint": "npm -w widget run lint",
    "test": "npm -w widget run test",
    "analyze": "npm -w widget run analyze",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d demo/dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
