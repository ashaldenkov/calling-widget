{
  "name": "call-widget",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.loader.config.ts",
    "preview": "tsc --noEmit && vite build && vite build --config vite.loader.config.ts && vite preview --port 3005",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run lint:fix && npm run prettier:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@preact/signals": "^2.9.0",
    "@tanstack/preact-query": "^5.100.5",
    "countries-and-timezones": "^3.8.0",
    "countries-list": "^3.2.2",
    "country-flag-icons": "^1.6.14",
    "deepsignal": "^1.6.0",
    "janus-gateway": "^1.4.0",
    "preact": "^10.0.0",
    "webrtc-adapter": "^9.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@preact/preset-vite": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.7"
  }
}
